{
  "api": {
    "tag": "api",
    "services": [ "HandlerService", "RoutingService" ]
  },
  "stats": {},
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10890,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    },
    {
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "dokodemo-door",
      "settings": { "address": "127.0.0.1" }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ],
  "routing": {
    "settings": {
      "rules": [
        {
          "type": "field",
          "inboundTag": [ "api" ],
          "outboundTag": "api"
        }
      ]
    }
  }
}