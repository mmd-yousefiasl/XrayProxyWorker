      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "Benchmark": {
    "MaxConfigs": 5000,
    "Sources": [
      "https://github.com/Epodonios/v2ray-configs/blob/main/Sub1.txt",
